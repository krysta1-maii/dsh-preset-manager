{
  "name": "dsh-preset-manager",
  "version": "0.1.0",
  "description": "Configure preset visibility and display order in DSH.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "dsh": "=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "policy.js",
    "client.js",
    "adapter.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "VERIFICATION.md",
    "compatibility.json",
    "src/*.js",
    "scripts/*.js",
    "tests/*.test.js",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run build && node --check client.js && node --check index.js && npm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-agent-preset",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
